{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "endOfLine": "lf",
  "arrowParens": "always",
  "bracketSpacing": true,
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": true,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "public",
    ".astro",
    ".turbo",
    ".vercel",
    "out",
    "package-lock.json"
  ]
}
