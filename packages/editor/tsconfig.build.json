{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": false,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "rootDir": "src",
        "noEmit": false,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "types": [
            "react",
            "react-dom",
            "vite/client"
        ]
    },
    "include": [
        "src/index.tsx",
        "src/components/**/*.tsx",
        "src/core/**/*.ts",
        "src/hooks/**/*.ts",
        "src/types/**/*.ts",
        "src/utils/**/*.ts",
        "types"
    ],
    "exclude": [
        "src/main.tsx",
        "src/App.tsx",
        "src/components/Header.tsx",
        "src/**/__tests__/**",
        "test/**",
        "**/*.test.ts",
        "**/*.test.tsx"
    ]
}
