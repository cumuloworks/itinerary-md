{
  "name": "@itinerary-md/editor",
  "version": "0.3.3",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && vite build",
    "types:watch": "tsc -w -p tsconfig.build.json",
    "build:watch": "vite build --watch",
    "pack:watch": "concurrently -k -n types,build \"npm:types:watch\" \"npm:build:watch\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ariakit/react": "^0.4.42",
    "@monaco-editor/react": "^4.7.0",
    "buffer": "^6.0.3",
    "color-hash": "2.0.2",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "luxon": "^3.7.2",
    "mdast-util-to-string": "^4.0.0",
    "pako": "^3.0.2",
    "radix-ui": "^1.8.1",
    "react-hot-toast": "^2.6.1",
    "react18-json-view": "^0.2.10",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.0",
    "remark-itinerary": "^0.3.3",
    "remark-itinerary-alert": "^0.2.3",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/color-hash": "2.0.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxc-transform-react": "^0.152.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "engines": {
    "node": ">=20.19"
  }
}
