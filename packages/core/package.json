{
  "name": "remark-itinerary",
  "version": "0.3.2",
  "private": false,
  "keywords": [
    "itinerary",
    "markdown",
    "mdast",
    "parser",
    "plugin",
    "remark",
    "travel"
  ],
  "homepage": "https://github.com/cumuloworks/itinerary-md#readme",
  "bugs": {
    "url": "https://github.com/cumuloworks/itinerary-md/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cumuloworks/itinerary-md.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "rimraf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "dev": "tsc -w -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepack": "npm run build",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "expr-eval-fork": "^3.0.3",
    "luxon": "^3.7.2",
    "mdast-util-to-string": "4.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "remark-parse": "^11.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "unified": "^11.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
