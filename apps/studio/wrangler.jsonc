{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripmd-studio",
  "account_id": "74b4cfd822d1cbd10244453900fee557",
  "compatibility_date": "2026-09-15",
  // Only the custom domain serves production; per-version preview URLs stay on for PR builds.
  "workers_dev": false,
  "preview_urls": true,
  // Static site: no Worker script, the built site is served as static assets.
  "assets": {
    "directory": "./dist",
  },
  "routes": [
    {
      "pattern": "tripmd.dev",
      "custom_domain": true,
      "zone_name": "tripmd.dev",
    },
  ],
}
